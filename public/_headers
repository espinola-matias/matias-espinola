# Cloudflare Pages — cabeceras por ruta

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Vite les pone un hash en el nombre: si cambia el contenido cambia la URL,
# así que se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Estos conservan el nombre entre deploys, así que van a 30 días.
/logo/*
  Cache-Control: public, max-age=2592000
/perfil-432.jpg
  Cache-Control: public, max-age=2592000
/perfil-864.jpg
  Cache-Control: public, max-age=2592000
/certificados/*
  Cache-Control: public, max-age=2592000

# El HTML tiene que revalidarse o un deploy nuevo no se vería.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
